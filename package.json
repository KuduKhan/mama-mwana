{
  "name": "mama-mwana",
  "private": true,
  "version": "2.0.0-beta.11",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run tests",
    "typecheck": "tsc --noEmit",
    "test:ui": "playwright test -c playwright.config.mjs",
    "test:security": "vitest run tests/v08Security.test.ts",
    "security:client": "node scripts/check-client-bundle.mjs",
    "security:sql": "node scripts/check-sql-release.mjs",
    "test:local:security": "node scripts/run-local-security.mjs",
    "test:local:prepare": "node scripts/prepare-local-migrations.mjs",
    "quality:bundle": "node scripts/check-entry-budget.mjs",
    "release:v2:status": "node scripts/check-v2-readiness.mjs",
    "release:v2:authorize": "node scripts/check-v2-readiness.mjs --require-go",
    "release:v2:technical-evidence": "node scripts/record-v2-technical-evidence.mjs build",
    "release:v2:isolation-evidence": "node scripts/record-v2-technical-evidence.mjs local-isolation",
    "release:v2:privacy-safety": "node scripts/check-beta-privacy-safety.mjs",
    "release:v2:acceptance-packet": "node scripts/generate-v200-acceptance.mjs",
    "security:rpc-review": "node scripts/audit-privileged-rpc-boundaries.mjs",
    "quality:experience": "node scripts/check-v2-experience.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vitest": "^3.0.0",
    "@playwright/test": "1.55.0"
  }
}
