# Copy to .env.local for a live, authenticated application.
# Only public Supabase identifiers go here. NEVER add service-role keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Fail-closed by default. Do not enable until medical, security and privacy approvals are complete.
VITE_AUTH_ACCESS_ENABLED=false
