# MamaMwana uses Vite (VITE_*), not Next.js (NEXT_PUBLIC_*).
# Copy this to .env.local locally or configure Vercel environment variables.
# Public project URL and publishable API key are safe for a browser.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_YOUR_KEY
# Backward-compatible alternative (not needed with a modern publishable key):
# VITE_SUPABASE_ANON_KEY=
# This gate must stay false until independent medical/privacy/security/2-account testing.
VITE_AUTH_ACCESS_ENABLED=false
# Never add Supabase secret, database password, or service_role key to VITE_*.
